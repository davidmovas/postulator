    "wait": 1400
  },
  {
    "name": "graph-entity-card",
    "route": "#/s/:siteId/graph?view=outline",
    "height": 1600,
    "wait": 1400,
    "steps": [
      {
        "click": "[data-entity-row=category]"
      },
      {
        "wait": 900
      }
    ]
  },
  {
    "name": "graph-card-proposals",
    "route": "#/s/:siteId/graph?view=outline",
    "height": 1200,
    "wait": 1400,
    "steps": [
      {
        "click": "[data-card-proposals-open]"
      },
      {
        "wait": 900
      },
      {
        "click": "[data-card-proposal] button[title]"
      },
      {
        "wait": 900
      },
      {
        "click": "[data-card-proposal-waiting] button"
      },
      {
        "wait": 900
      }
    ]
  },
  {
    "name": "propose-entities-picked",
    "route": "#/s/:siteId/graph",
    "wait": 1500,
    "steps": [
      {
        "click": "main button:has-text(\"Model\")"
      },
      {
        "click": "[role=menuitem]:has-text(\"Propose entities from the pages\")"
      },
      {
        "expect": "[role=dialog] [data-page-pick] input:not([disabled])"
      },
      {
        "click": ":nth-match([role=dialog] [data-page-pick] label:has(input:not([disabled])), 1)"
      },
      {
        "click": ":nth-match([role=dialog] [data-page-pick] label:has(input:not([disabled])), 2)"
      },
      {
        "expect": "[role=dialog] [data-page-pick] input:checked",
        "count": 2
      },
      {
        "wait": 400
      }
    ]
  },
  {
    "name": "propose-entities-kept",
    "route": "#/s/:siteId/graph",
    "wait": 1500,
    "steps": [
      {
        "click": "nav[aria-label=\"Sections\"] a[title=\"Pages\"]"
      },
      {
        "expect": "[data-page-row]"
      },
      {
        "click": "[aria-label=\"Switch site\"]"
      },
      {
        "click": "[role=dialog] button:has-text(\"Tamper Supply\")"
      },
      {
        "wait": 800
      },
      {
        "click": "[aria-label=\"Switch site\"]"
      },
      {
        "click": "[role=dialog] button:has-text(\"Crema Bench\")"
      },
      {
        "wait": 800
      },
      {
        "click": "nav[aria-label=\"Sections\"] a[title=\"Graph\"]"
      },
      {
        "wait": 1500
      },
      {
        "click": "main button:has-text(\"Model\")"
      },
      {
        "click": "[role=menuitem]:has-text(\"Propose entities from the pages\")"
      },
      {
        "expect": "[role=dialog] [data-page-pick] input:checked",
        "count": 2
      },
      {
        "expect": "[role=dialog] button:has-text(\"Start over\")"
      },
      {
        "fits": "[data-workspace]"
      },
      {
        "wait": 400
      }
    ]
  },
  {
    "name": "propose-entities-review",
    "route": "#/s/:siteId/findings?code=page_without_entity",
    "wait": 1500,
    "steps": [
      {
        "click": "button:has-text(\"Propose entities for all\")"
      },
      {
        "expect": "[data-workspace] [data-proposal-at]",
        "timeout": 20000
      },
      {
        "click": ":nth-match([data-workspace] [data-proposal-at]:has(button[aria-expanded]), 1)"
      },
      {
        "type": "[data-proposal-inspector] input=Field notes"
      },
      {
        "expect": "[data-workspace] [data-proposal-at]:has-text(\"Field notes\")"
      },
      {
        "click": ":nth-match([data-workspace] [data-proposal-at]:has(button[aria-expanded]) label, 1)"
      },
      {
        "expect": "[data-workspace] [data-proposal-state=off]"
      },
      {
        "fits": "[data-workspace]"
      },
      {
        "wait": 400
      }
    ]
  },
  {
    "name": "propose-entities-review-960",
    "route": "#/s/:siteId/findings?code=page_without_entity",
    "width": 960,
    "height": 600,
    "wait": 1500,
    "steps": [
      {
        "expect": "[data-agent-dock]"
      },
      {
        "click": "button:has-text(\"Propose entities for all\")"
      },
      {
        "expect": "[data-workspace] [data-proposal-at]:has-text(\"Field notes\")",
        "timeout": 20000
      },
      {
        "fits": "[data-workspace]"
      },
      {
        "wait": 400
      }
    ]
  },
  {
    "name": "propose-entities-review-kept",
    "route": "#/s/:siteId/findings?code=page_without_entity",
    "wait": 1500,
    "steps": [
      {
        "click": "nav[aria-label=\"Sections\"] a[title=\"Pages\"]"
      },
      {
        "expect": "[data-page-row]"
      },
      {
        "click": "[aria-label=\"Switch site\"]"
      },
      {
        "click": "[role=dialog] button:has-text(\"Tamper Supply\")"
      },
      {
        "wait": 800
      },
      {
        "click": "[aria-label=\"Switch site\"]"
      },
      {
        "click": "[role=dialog] button:has-text(\"Crema Bench\")"
      },
      {
        "wait": 800
      },
      {
        "click": "nav[aria-label=\"Sections\"] a[title=\"Findings\"]"
      },
      {
        "click": "main nav button:has-text(\"Page without an entity\")"
      },
      {
        "click": "button:has-text(\"Propose entities for all\")"
      },
      {
        "expect": "[data-workspace] [data-proposal-at]:has-text(\"Field notes\")",
        "timeout": 20000
      },
      {
        "expect": "[data-workspace] [data-proposal-state=off]"
      },
      {
        "expect": "[data-proposal-inspector] input"
      },
      {
        "fits": "[data-workspace]"
      },
      {
        "wait": 400
      }
    ]
  },
